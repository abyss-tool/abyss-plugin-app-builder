<?xml version="1.0" encoding="utf-8"?>
<!-- N-APP-001 FR-003：宿主入口 + UI 入口 meta-data 与权限声明。
     entry 类与 plugin.json "entry" 字段一致（CI 门禁校验）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 构建产物安装引导：真实安装走系统安装器（同宿主门禁语义） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- HOST_API v1：宿主经 PackageManager meta-data 发现插件入口 -->
        <meta-data
            android:name="com.abyss.tools.plugin.HOST_ENTRY"
            android:value="com.abyss.plugin.appbuilder.AppBuilderPlugin" />
        <meta-data
            android:name="com.abyss.tools.plugin.UI_ENTRIES"
            android:value="com.abyss.plugin.appbuilder.BuilderActivity" />

        <activity
            android:name=".BuilderActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
